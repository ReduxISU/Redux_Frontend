# Base URL the app's server-side API proxy (pages/api/redux/[...path].js) forwards
# requests to. Never exposed to the browser directly. Copy this file to `.env.local`
# to actually use it — see the README's "Environment variables" section.

# Default: the live production Redux backend. Real data, no local backend needed —
# this is what most people should use to get started.
REDUX_BASE_URL=https://redux.isu.edu/api/redux/

# Alternative: a Redux backend you're running yourself locally (e.g. via the Redux
# repo's devcontainer, listening on :27000). Uncomment this line AND comment out
# the one above if you're also working on/running the backend.
# REDUX_BASE_URL=http://localhost:27000/
